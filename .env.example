# Server-only. Do not prefix with VITE_ and never expose this in the browser.
SUPABASE_URL=https://naanarmoktmsumkxmjvj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
APP_ALLOWED_ORIGIN=http://localhost:3000
PAYROLL_EXPORT_BUCKET=payroll-exports
READINESS_SECRET=long-random-readiness-secret
CRON_SECRET=long-random-cron-secret

# Local sandbox only. Keep this in `.env.production-snapshot`, never commit it.
# Use a dedicated database connection with read-only privileges; do not put a
# Supabase service-role JWT here. The runner validates the production ref and
# forces read-only transactions before taking a snapshot.
HOPIN_PROD_DB_URL=postgresql://readonly:password@db.production-ref.supabase.co:5432/postgres?sslmode=require
HOPIN_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
HOPIN_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
HOPIN_LOCAL_PORT=3000
# Optional fallback if `supabase status -o env` cannot provide it:
# HOPIN_LOCAL_SERVICE_ROLE_KEY=local-only-service-role-key
