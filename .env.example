# Production deployment variables are configured in Vercel, not in this file.
# Never expose a service key through a VITE_ variable or commit a real value.
SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-server-only-service-role-key
APP_ALLOWED_ORIGIN=http://localhost:3000
PAYROLL_EXPORT_BUCKET=payroll-exports
READINESS_SECRET=local-readiness-secret
CRON_SECRET=local-cron-secret

# Official local development target. Copy this file to `.env.staging.local`.
# The file is ignored by Git and must point to a dedicated Supabase project,
# never to the protected production project.
HOPIN_RUNTIME=staging
HOPIN_STAGING_PROJECT_REF=your-20-character-staging-ref
HOPIN_STAGING_DB_URL=postgresql://postgres:password@db.your-staging-project-ref.supabase.co:5432/postgres?sslmode=require
PORT=3000
E2E_PORT=4173

# Optional smoke override. The orchestrator generates a disposable PIN when omitted.
# E2E_FIXTURE_PIN=generated-per-run
