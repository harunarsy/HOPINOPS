{
  "name": "hopin-stock-operations",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "node scripts/start-local-sandbox.mjs",
    "dev:full": "pnpm dev:local",
    "db:local:sync": "node scripts/sync-production-to-local.mjs --confirm-local-sandbox",
    "db:local:verify": "node scripts/verify-local-target.mjs",
    "test:operator:local": "node scripts/run-local-operator-smoke.mjs",
    "ops:verify": "node scripts/verify-local-release.mjs",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/run-remote-db-tests.mjs",
    "test:db:fresh": "node scripts/run-remote-db-tests.mjs --migrate",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test",
    "test:e2e:playwright": "playwright test",
    "test:watch": "vitest",
    "provision:user": "node scripts/provision-user.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@vitejs/plugin-react": "^6.1.1",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "~5.8.3",
    "vercel": "^59.11.7",
    "vitest": "^5.0.0"
  }
}
